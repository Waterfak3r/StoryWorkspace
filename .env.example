# Project truth is the workspace folder of JSON projects, not SQLite.
STORY_WORKSPACE_ROOT=.data/projects

# Leftover SQLite path for older code. Not required to start the studio.
STORY_WORKSPACE_DB_PATH=.data/story-workspace.db

# Optional AI provider configuration. Leave blank to disable AI, or set values in Settings.
# The Settings UI writes user-level credentials to .data/user/providers.json (not project JSON).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# auto | chat | responses. OpenCode Go (https://opencode.ai/zen/go/v1) needs chat.
AI_PROTOCOL=auto
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
